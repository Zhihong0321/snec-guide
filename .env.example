# UniAPI / Gemini (required for Gemini model in chat)
UNIAPI_KEY=your-uniapi-key-here
UNIAPI_BASE_URL=https://api.uniapi.io
GEMINI_MODEL=gemini-3.1-flash-lite

# OpenAI-compatible chat (default: MiniMax via OKAI gateway)
OPENAI_API_KEY=your-openai-compatible-key-here
OPENAI_BASE_URL=https://www.okaoi.com/v1
OPENAI_MODEL=MiniMax-M2.7
DEFAULT_CHAT_MODEL=MiniMax-M2.7
# Image attachments on MiniMax M2.7 use UniAPI Gemini vision (same UNIAPI_KEY)
# IMAGE_VISION_MODEL=gemini-3.1-flash-lite

# PostgreSQL (exhibitor context)
DATABASE_URL=postgresql://postgres:PASSWORD@host:port/railway

# Web snippets (DuckDuckGo via `ddgs` package). Set false to skip.
ENABLE_WEB_SEARCH=true
